  (text "FUJISOKU SRAM Utility - Arduino UNO R4 shield"
    (at 20 22 0)
    (effects
      (font
        (size 2.5 2.5) bold)
      (justify left bottom))
    (uuid "d5881a8c-9d9b-59c6-b34c-d27426894ee0"))
  (text "Single 5 V supply from the Arduino 5V pin. All parts are 5 V, no level shifting."
    (at 20 27 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left bottom))
    (uuid "6ad8e416-b09b-5b5a-a5eb-a4d126d8edac"))
  (text "SPI (D13 SCK, D12 MISO, D11 MOSI) is shared by both MCP23S17, the SPI SRAM and the SD card module."
    (at 20 29.54 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left bottom))
    (uuid "d6fd2b28-d686-560e-8f01-ce9a1e72a442"))
  (text "Labels with the same name are connected. Source: docs/hardware.md, FUJISOKU_SRAM_COPY/config.h (v2.8)."
